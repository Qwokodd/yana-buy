# Copy this file to .env (the server also works without one in development).
PORT=4000
DATABASE_URL=postgresql://yanabuy:yanabuy_dev_password@localhost:5433/yanabuy

# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars

# Web (3000), admin (3001), Expo web (8081). Add your phone's Expo address if needed.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Public address of this API, used in image links. Leave empty locally.
PUBLIC_URL=

# MTN Mobile Money (Collections). Leave empty to keep MoMo switched off.
# Get these from YanaBuy's MTN MoMo developer / merchant account. For live payments set
# MTN_MOMO_BASE_URL to the production address MTN gives you and MTN_MOMO_TARGET_ENV to your
# live environment name (e.g. mtnliberia).
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CURRENCY=USD
# Live only: where MTN reports finished payments. Must match the callback host in MTN's partner portal. Leave empty in the sandbox.
MTN_MOMO_CALLBACK_URL=

# MTN Mobile Money (Disbursements) — the Send by MoMo button in Admin > Who we owe.
# Its own subscription key, API user and API key. Leave empty to keep sending switched off.
MTN_DISB_SUBSCRIPTION_KEY=
MTN_DISB_API_USER=
MTN_DISB_API_KEY=

# The website's address, used for links in emails and text messages.
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# EMAIL (sign-up codes and notifications). Any SMTP service works:
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<a Google "app password">
#   Zoho:   SMTP_HOST=smtp.zoho.com   SMTP_PORT=587
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# Leave SMTP_HOST empty to keep email off (codes are then printed in the server window, and email isn't required).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=YanaBuy <no-reply@yanabuy.com>

# SMS through Twilio (texts Liberia and the USA). From the Twilio console:
# Account SID, Auth Token, and either a Twilio phone number (TWILIO_FROM=+1...) or a Messaging Service SID.
# Best: a Messaging Service with BOTH senders in its pool — the alphanumeric sender "YanaBuy" (for Liberia;
# MTN Liberia only delivers from a PRE-REGISTERED alphanumeric sender, ~3 weeks) and a US toll-free or 10DLC number (for +1).
# Test with:  npm run test-sms -- 0886000000
# Leave TWILIO_ACCOUNT_SID empty to keep SMS off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# LOGIN CODES: after the password, a 6-digit code goes by text (phone login) or email (email login).
# Admins get one every time; everyone else can tick "Trust this device" to skip it for 30 days.
# Codes only start once email or SMS above is set up. Set LOGIN_CODES=off to switch them off.
LOGIN_CODES=on
