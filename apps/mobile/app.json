{
  "expo": {
    "name": "YanaBuy",
    "slug": "yanabuy",
    "scheme": "yanabuy",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4EF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yanabuy.app"
    },
    "android": {
      "package": "com.yanabuy.app",
      "adaptiveIcon": {
        "backgroundColor": "#491F67",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "YanaBuy uses your photos so you can add a profile picture and product photos.",
          "cameraPermission": "YanaBuy uses the camera so you can take a profile picture, product photos and ID photos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#491F67"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#491F67",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34195f8a-40a0-4342-8018-43291ad0bc82"
      }
    },
    "owner": "davedark"
  }
}
